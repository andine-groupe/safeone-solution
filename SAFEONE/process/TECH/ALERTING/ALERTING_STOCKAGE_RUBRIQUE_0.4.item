    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA; select distinct dds.IDSITE,&#xD;&#xA; ddl.NOM_LOCATAIRE  as LOCATAIRE,&#xD;&#xA; ddc.CELLULE,&#xD;&#xA; ddc.RUBRIQUE_ICPE,&#xD;&#xA; UPPER(dfs.ALERTE_CELLULE) ,&#xD;&#xA; UPPER(dfs.ALERTE_DESIGNATION) ,&#xD;&#xA; UPPER(dfs.ALERTE_NB_PALETTE),&#xD;&#xA; UPPER(dfs.ALERTE_POIDS_VOLUME),&#xD;&#xA; UPPER(dfs.ALERTE_ICPE) ,&#xD;&#xA; UPPER(dfs.ALERTE_SITE),&#xD;&#xA; UPPER(dfs.ALERTE_UNITE) ,&#xD;&#xA; UPPER(dfs.ALERTE_DEGRE),&#xD;&#xA; UPPER(dfs.ALERTE_CONTENANCE_M3)&#xD;&#xA; from dwh_f_stocks dfs&#xD;&#xA; left outer join dwh_d_site dds on dfs.IDCLIENTSITE =dds. IDCLIENTSITE &#xD;&#xA; left outer join dwh_d_cellules ddc   on dfs.IDCELLULE  =ddc.IDCELLULE &#xD;&#xA; left outer join dwh_d_articles dda  on dfs.IDARTICLE =dda.IDARTICLE&#xD;&#xA; left outer join dwh_d_locataires ddl  on dfs.IDLOCATAIRE =ddl.IDLOCATAIRE &#xD;&#xA;&#xD;&#xA;&quot;"/>
