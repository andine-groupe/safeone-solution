  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1520" posY="2120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="output_row.SITE = row22.IDSITE ;&#xD;&#xA;output_row.LOCATAIRE = row22.LOCATAIRE ;&#xD;&#xA;output_row.mail_body =&#xD;&#xA;&quot;&lt;html>&lt;body>&quot; +&#xD;&#xA;&quot;&lt;p>Bonjour,&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Rapport d'alertes pour le site : &quot; + row22.IDSITE + &quot;&lt;/p>&quot; +&#xD;&#xA;&#xD;&#xA;// Tableau - alertes cellule&#xD;&#xA;((row22.message_alerte_cellule != null &amp;&amp; !row22.message_alerte_cellule.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ces Locataires/Cellules/Rubriques  ont une alerte cellule :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Locataire&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Cellule&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Rubrique&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.message_alerte_cellule.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - alertes designation&#xD;&#xA;((row22.message_alerte_designation != null &amp;&amp; !row22.message_alerte_designation.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ces Locataires/Cellules/Rubriques ont une alerte designation :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Locataire&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Cellule&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Rubrique&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.message_alerte_designation.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - alertes nb palette&#xD;&#xA;((row22.message_alerte_nb_palette != null &amp;&amp; !row22.message_alerte_nb_palette.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ces Locataires/Cellules/Rubriques ont une alerte sur le nombre de palette :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Locataire&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Cellule&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Rubrique&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.message_alerte_nb_palette.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - alertes poids&#xD;&#xA;((row22.message_alerte_poids != null &amp;&amp; !row22.message_alerte_poids.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ces Locataires/Cellules/Rubriques ont une alerte sur le poids :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Locataire&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Cellule&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Rubrique&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.message_alerte_poids.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|