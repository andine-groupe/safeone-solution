    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;/*Recuperation que les sous ordres*/&#xD;&#xA;select ddls.IDSITE ,&#xD;&#xA;ORDRE as SOUS_ORDRE,&#xD;&#xA;SUBSTRING_INDEX(ORDRE, '.', 1) AS ORDRE_FINAL,&#xD;&#xA;ddsm.PRESTATION,&#xD;&#xA;ddsm.PRESTATAIRE,&#xD;&#xA;ddsm.DATE_PROCHAINE_VERIFICATION,&#xD;&#xA;CASE &#xD;&#xA;        WHEN DATE_PROCHAINE_VERIFICATION BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 30 DAY) &#xD;&#xA;        THEN 'Oui'&#xD;&#xA;        ELSE 'Non'&#xD;&#xA; END AS PROCHAINE_VERIFICATION_PREVUS_30J ,&#xD;&#xA;DATE(STR_TO_DATE(ddsm.DATE_RECEPTION_RAPPORT, '%a %b %d %H:%i:%s UTC %Y')),&#xD;&#xA;ddsm.PRESENCE_RESERVES,&#xD;&#xA;CASE &#xD;&#xA;        WHEN ddsm.DATE_RECEPTION_RAPPORT is not null and  ddsm.PRESENCE_RESERVES ='Oui'&#xD;&#xA;        THEN 'Oui'&#xD;&#xA;        ELSE 'Non'&#xD;&#xA; END AS RAPPORT_AVEC_RESERVE, &#xD;&#xA;ddsm.DEVIS_DEMANDE,&#xD;&#xA;DATE(STR_TO_DATE(DATE_RECEPTION_DEVIS, '%a %b %d %H:%i:%s UTC %Y')),&#xD;&#xA;CASE &#xD;&#xA;        WHEN ddsm.DATE_RECEPTION_DEVIS is not null and  ddsm.DEVIS_DEMANDE ='Oui'&#xD;&#xA;        THEN 'Oui'&#xD;&#xA;        ELSE 'Non'&#xD;&#xA; END AS DEMANDE_DEVIS_ENCOURS, &#xD;&#xA;ddsm.DATE_INTERVENTION,&#xD;&#xA;ddsm.STATUT,&#xD;&#xA;CASE &#xD;&#xA;        WHEN ddsm.DATE_INTERVENTION is not null and  ddsm.STATUT &lt;> 'Tvx finalisés'&#xD;&#xA;        THEN 'Oui'&#xD;&#xA;        ELSE 'Non'&#xD;&#xA; END AS INTERVENTION_ENCOURS&#xD;&#xA;from dwh_d_suivi_maintenance  ddsm&#xD;&#xA;left join  dwh_d_site ddls  on  ddsm.IDCLIENTSITE = ddls.IDCLIENTSITE &#xD;&#xA;where ddsm.ORDRE  LIKE '%.%'&#xD;&#xA;&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false" show="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
