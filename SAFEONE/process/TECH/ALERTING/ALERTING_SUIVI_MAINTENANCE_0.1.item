  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1280" posY="1760">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="output_row.SITE = row22.IDSITE ;&#xD;&#xA;output_row.mail_body =&#xD;&#xA;&quot;&lt;html>&lt;body>&quot; +&#xD;&#xA;&quot;&lt;p>Bonjour,&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Rapport d'alertes pour le suivi de maintenance du site : &quot; + row22.IDSITE + &quot;&lt;/p>&quot; +&#xD;&#xA;&#xD;&#xA;// Tableau - verification prevue&#xD;&#xA;((row22.Messages_verification_prevus != null &amp;&amp; !row22.Messages_verification_prevus.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ce site à des verification qui sont prevue dans les 30 jours .&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Vous trouverez ci dessous les prestations, les prestataires et la date de la prochaine verification :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation initial&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Sous ordre&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestataires&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Date de la prochaine verification&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.Messages_verification_prevus.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - Messages_reserve&#xD;&#xA;((row22.Messages_reserve != null &amp;&amp; !row22.Messages_reserve.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ce site a reçu un/des rapport(s) avec un reserve.&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Vous trouverez ci dessous les prestations, les prestataires et la date de reception du rapport :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation initial&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Sous ordre&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestataires&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Date de reception du rapport&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.Messages_reserve.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - Messages_devis&#xD;&#xA;((row22.Messages_devis != null &amp;&amp; !row22.Messages_devis.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ce site a reçu un/des devis.&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Vous trouverez ci dessous les prestations, les prestataires et la date de reception du devis :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation initial&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Sous ordre&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestataires&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Date de reception du devis&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.Messages_devis.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;// Tableau - intervention&#xD;&#xA;((row22.Messages_intervention != null &amp;&amp; !row22.Messages_intervention.isEmpty()) ?&#xD;&#xA;&quot;&lt;p>Ce site a reçu un/des demande(s) d'intervention.&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;p>Vous trouverez ci dessous les prestations, les prestataires et la date d'intervnetion :&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;table border='1' cellpadding='5' cellspacing='0' style='border-collapse:collapse;'>&quot; +&#xD;&#xA;&quot;&lt;tr style='background-color:#4472C4; color:white;'>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation initial&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Sous ordre&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestation&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Prestataires&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;th>Date d'intervention&lt;/th>&quot; +&#xD;&#xA;&quot;&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;tr>&lt;td>&quot; + row22.Messages_intervention.replace(&quot;,&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;).replace(&quot;|&quot;, &quot;&lt;/td>&lt;td>&quot;).replace(&quot;\n&quot;, &quot;&lt;/td>&lt;/tr>&lt;tr>&lt;td>&quot;) + &quot;&lt;/td>&lt;/tr>&quot; +&#xD;&#xA;&quot;&lt;/table>&lt;br/>&quot; : &quot;&quot;) +&#xD;&#xA;&quot;&lt;p>Cordialement,&lt;/p>&quot; +&#xD;&#xA;&quot;&lt;/body>&lt;/html>&quot;;&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" key="false" length="-1" name="mail_body" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="-1" name="SITE" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
